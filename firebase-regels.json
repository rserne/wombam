{
  "rules": {
    "wombam": {
      "rooms": {
        "$code": {
          ".read": "auth != null && $code.matches(/^[A-Z]{4}$/)",
          ".write": "auth != null && $code.matches(/^[A-Z]{4}$/)",
          ".validate": "newData.hasChildren(['d', 'rev'])",
          "d": { ".validate": "newData.isString() && newData.val().length <= 20000" },
          "rev": { ".validate": "newData.isNumber()" },
          "t": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
